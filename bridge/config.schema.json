{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "api_id",
    "phone",
    "base_url",
    "model",
    "wpm",
    "words",
    "active_preset",
    "presets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "api_id": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^[0-9]*$"
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "base_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "model": {
      "type": "string",
      "maxLength": 120
    },
    "wpm": {
      "type": "integer",
      "minimum": 25,
      "maximum": 300
    },
    "words": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "active_preset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "prompts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "prompts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            }
          }
        }
      }
    }
  }
}